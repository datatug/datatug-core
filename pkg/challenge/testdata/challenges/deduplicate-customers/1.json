  "hints": [
    {
      "id": "hint-1",
      "text": "Group rows by the exact stored email value; NULL is still one group."
    },
    {
      "id": "hint-2",
      "text": "The retention rule is the lowest numeric id, not the earliest created_at."
    },
    {
      "id": "hint-3",
      "text": "Delete rows for which a lower id exists in the same BINARY email group."
    }
  ],
  "referenceSolutions": [
    {
      "partId": "delete-duplicates",
      "answer": {
        "sql": "DELETE FROM customers\nWHERE EXISTS (\n  SELECT 1 FROM customers AS keep\n  WHERE keep.email IS customers.email COLLATE BINARY\n    AND keep.id < customers.id\n)"
      }
    },
    {
      "partId": "prevention-check",
      "answer": {
        "checkDefinition": {
          "queryId": "queries/duplicate-emails",
          "expectation": {
            "id": "no-duplicates",
            "scope": "set",
            "kind": "row-count",
            "severity": "critical",
            "expected": {
              "type": "integer",
              "value": "0"
            }
          }
        }
      }
    }
