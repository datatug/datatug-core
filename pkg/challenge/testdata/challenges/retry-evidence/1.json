  "hints": [
    {
      "id": "hint-1",
      "text": "Join retry events to payments by attempt_id."
    },
    {
      "id": "hint-2",
      "text": "Count only succeeded payments, then group by request_id."
    },
    {
      "id": "hint-3",
      "text": "A request with a failed attempt and one success is not a duplicate."
    }
  ],
  "referenceSolutions": [
    {
      "partId": "requests",
      "answer": {
        "sql": "SELECT r.request_id, COUNT(*) AS successes\nFROM retry_events r\nJOIN payments p ON p.attempt_id = r.attempt_id\nWHERE p.status = 'succeeded'\nGROUP BY r.request_id\nHAVING COUNT(*) > 1"
      }
    },
    {
      "partId": "evidence-pairs",
      "answer": {
        "structured": {
          "selections": {
            "evidence-pairs": [
              "r2-a2-a3-trace",
              "r4-a6-a7-trace"
            ]
          }
        }
      }
    }
  ]
